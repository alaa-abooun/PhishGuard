FLASK_ENV=development
SECRET_KEY=phishing-sim-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database - use SQLite for easy local dev, or set PostgreSQL URL
DATABASE_URL=sqlite:///phishing_sim.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Ollama LLM (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Mail (mock for demo - set MAIL_SUPPRESS_SEND=True to disable real sending)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SUPPRESS_SEND=True

FRONTEND_URL=http://localhost:3000
